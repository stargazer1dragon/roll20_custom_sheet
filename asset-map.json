{
  "pack": "Valkyn 5e modular artwork",
  "version": "0.3",
  "asset_count": 38,
  "root": "assets/ui/v3/",
  "all_images": "RGBA PNG;4 source pixels per1 CSS px; all documented text/input regions fully transparent",
  "assembly_rules": [
    "The PNG dimensions are NOT their CSS display size. Set width/height from display_size_css_px.",
    "Do not stretch a fixed PNG to a different aspect ratio. Reuse nine-slice frames for variable-height panels.",
    "Keep labels, numbers, input lines, checkmarks, and dice formulas in HTML; no text is baked into the art.",
    "Art does not replace actual inputs, buttons or native repeating-section controls. Backgrounds cannot capture clicks; decorative overlays must have pointer-events:none.",
    "Use an opaque white or pale sheet/panel surface UNDER the transparent frame. Put editable controls above it; do not cover art with opaque field backgrounds.",
    "The five currency fields are separate repeated controls; do not use the old three-circle inventory image.",
    "The six ability modules and four characteristics modules are independent; do not use the old fixed column/composite PNGs.",
    "For nine-slice PNGs, set border-image-slice in SOURCE pixels, explicit border-image-width in CSS pixels, and omit fill. In a pseudo-element use inset:0;pointer-events:none.",
    "The art supports original 2014 placement but does not itself implement the layout. A follow-up sheet HTML/CSS integration is required."
  ],
  "reference_source": {
    "repo": "https://github.com/Roll20/roll20-character-sheets/tree/master/DD5thEditionLegacy",
    "local_evidence": "build_output_v0.3.2.zip/ORIGINAL_2014_SHEET.css and HTML",
    "css_sha256": "ff27f7890890c6498708860cb1ebfbc5cd789de57189b3ab9196ffc635bba70c",
    "basis": "Measured base AND decorated/theme overrides. Reference only; no Roll20 decorative artwork is included.",
    "caution": "750px content width does not mean750px total decorated header. The theme explicitly uses850x140px header with a negative50px left offset. Native CSS metrics are not zoomed screenshot pixels.",
    "important_distinction": "Base layout and decorated art overrides are separate CSS layers. The numeric metrics here are explicit source constraints or documented adapter sizes, never an assertion that public legacy source equals the current official sheet."
  },
